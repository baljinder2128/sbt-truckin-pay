# Copy to .env (or set in your host's dashboard). Everything is optional except on a public server, where you should set ADMIN_PASSWORD and JWT_SECRET.
PORT=3000
TZ=Australia/Melbourne
DATA_DIR=./data

# First office login, created on first start only
ADMIN_EMAIL=office@sbttruckin.com.au
ADMIN_PASSWORD=ChangeMe123!
JWT_SECRET=

# Email. Leave SMTP_HOST empty and emails are saved to data/outbox instead of sent.
# Gmail: SMTP_PASS is a 16-letter Google "app password", not the normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=baljinder2128@gmail.com
SMTP_PASS=
MAIL_FROM="SB Truckin Pay <baljinder2128@gmail.com>"

# Runsheet photo reading (optional). Without it drivers type times in.
ANTHROPIC_API_KEY=
